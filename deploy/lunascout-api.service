[Unit]
Description=LunaScout API
After=network-online.target
Wants=network-online.target

[Service]
User=lunascout
WorkingDirectory=/srv/lunascout/app/backend
EnvironmentFile=/etc/lunascout.env
# Caddy is the only thing that reaches this port, and it reports the visitor's real address.
ExecStart=/srv/lunascout/app/backend/.venv/bin/uvicorn lunascout.api.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
